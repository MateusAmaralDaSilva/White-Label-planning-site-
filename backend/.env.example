# Porta do servidor HTTP
PORT=4000

# Segredo usado para assinar os JWT. Troque por um valor forte em produção.
JWT_SECRET=troque-este-segredo-em-producao

# Validade do token (formato do jsonwebtoken: 15m, 2h, 7d, ...)
JWT_EXPIRES_IN=7d

# Origens permitidas pelo CORS (separadas por vírgula). O dev server do Vite roda em 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Conexão PostgreSQL — use a role da APLICAÇÃO (whitelabel_app), nunca a do dono.
# Ver db/README.md para criar o banco e aplicar as migrations.
DATABASE_URL=postgres://whitelabel_app:defina-uma-senha-forte-no-ambiente@localhost:5432/whitelabel

# Confiança em proxy reverso, para o rate-limit do login ler o IP real do cliente
# (X-Forwarded-For). Deixe vazio em conexão direta. Atrás de 1 proxy, use: 1
TRUST_PROXY=

# Máximo de conexões do pool por instância. Reduza ao rodar muitas instâncias
# atrás de um pooler (PgBouncer em modo transaction). Padrão: 10
DB_POOL_MAX=10
